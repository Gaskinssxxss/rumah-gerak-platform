{
  "name": "simple-auth",
  "version": "1.0.0",
  "description": "Simple auth app using MEVN stack",
  "main": "app.js",
  "scripts": {
    "backend": "nodemon app.js",
    "frontend": "npm run serve --prefix ./frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "npm install --prefix ./frontend/ && npm run build --prefix ./frontend/"
  },
  "keywords": [
    "MongoDB",
    "Express.js",
    "Vue.js",
    "Node.js",
    "JWT",
    "Vuex"
  ],
  "author": "Petr Chatrný",
  "dependencies": {
    "bcrypt": "^5.0.1",
    "body-parser": "^1.20.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.0.1",
    "express": "^4.22.3",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.13.12",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "whatsapp-web.js": "^1.34.8"
  },
  "devDependencies": {
    "concurrently": "^7.2.2",
    "nodemon": "^2.0.18"
  },
  "license": "ISC"
}
